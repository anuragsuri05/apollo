# --- core ---
DATABASE_URL=sqlite:///./data/getcontact.db
# DATABASE_URL=postgresql+psycopg://getcontact:getcontact@localhost:5432/getcontact
SECRET_KEY=change-me
APP_NAME=getcontact
USER_AGENT=getcontact/0.1 (your-email@example.com)
PUBLIC_URL=http://localhost:8000   # public base URL for open-tracking pixels and opt-out links
# --- email verification ---
SMTP_VERIFY=0            # 1 = do RCPT-TO probing on guessed emails (slow, some hosts block)
# --- contributor network / feedback loop ---
MAIL_SYNC_MINUTES=10     # how often the worker syncs connected mailboxes & CRMs
MAIL_SYNC_BATCH=500      # messages per mailbox per sync
# --- sequence sending ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# --- BYO free API keys for connectors (all optional) ---
HUNTER_API_KEY=
APOLLO_API_KEY=
COMPANIES_HOUSE_API_KEY=
OPENCORPORATES_TOKEN=
DATA_GOV_IN_API_KEY=
